# Canonical local template. Copy to .env.ctu; never commit filled values.
CTU_HOST=127.0.0.1
CTU_PORT=55434
CTU_DB=dns_ctu
CTU_USER=dns_ctu_owner
CTU_PASSWORD=
SUPERSET_PORT=8089
SUPERSET_METADATA_DB=dns_ctu_superset
SUPERSET_METADATA_USER=dns_ctu_metadata
SUPERSET_METADATA_PASSWORD=
SUPERSET_SECRET_KEY=
SUPERSET_ANALYTICS_USER=dns_ctu_reader
SUPERSET_ANALYTICS_PASSWORD=
SUPERSET_ADMIN_USER=
SUPERSET_ADMIN_PASSWORD=
SUPERSET_ADMIN_EMAIL=dns-admin@example.test
